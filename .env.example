# Copy to .env and fill in. Do not commit real secrets.
# Full reference: docs/ENV-TEMPLATE.md

# PostgreSQL (required for app + Prisma migrate/seed)
# Matches repo docker-compose.yml: docker compose up -d
# DATABASE_URL=postgresql://printfig:printfig@127.0.0.1:5432/printfig_staging

# Optional: pg pool size (default 10). Lower on serverless if you hit connection limits.
# PG_POOL_MAX=10

# NextAuth (required for login in production)
# NEXTAUTH_SECRET=   # openssl rand -base64 32
# OAuth callback base URL (production required for Google sign-in & correct password-reset email links)
# NEXTAUTH_URL=https://www.example.com

# Google sign-in (optional — both required to show “Continue with Google” on /login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Site URL for SEO (canonical, Open Graph, sitemap & robots). No trailing slash.
# 未设置时 sitemap/robots 会使用 http://localhost:3000，上线前请改为正式域名。
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Organization JSON-LD (optional — homepage structured data)
# NEXT_PUBLIC_ORGANIZATION_LOGO=https://www.example.com/logo.png
# NEXT_PUBLIC_ORGANIZATION_SAME_AS=https://twitter.com/...,https://instagram.com/...

# Order confirmation + password reset emails (optional — see README)
# Without RESEND_API_KEY, forgot-password still succeeds but no email is sent (check server logs).
# RESEND_API_KEY=
# RESEND_FROM="PrintFig <onboarding@resend.dev>"

# Stripe Checkout (optional — unset = demo checkout via POST /api/orders only)
# Test: STRIPE_SECRET_KEY=sk_test_...  |  Production: sk_live_...
# STRIPE_SECRET_KEY=
# Webhook signing secret — must match the same mode (test vs live) as STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=whsec_...

# Admin seed (optional): used only when this user does not exist yet (see docs/ENV-TEMPLATE.md)
# ADMIN_EMAIL=admin@printfig.com
# ADMIN_PASSWORD=change-me-strong-password
